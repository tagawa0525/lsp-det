{
  "rust-analyzer-via-lsp-det": {
    "command": "lsp-det",
    "args": ["--", "rust-analyzer"],
    "extensionToLanguage": { ".rs": "rust" }
  },
  "gopls-via-lsp-det": {
    "command": "lsp-det",
    "args": ["--", "gopls"],
    "extensionToLanguage": { ".go": "go" }
  },
  "pyright-via-lsp-det": {
    "command": "lsp-det",
    "args": ["--", "pyright-langserver", "--stdio"],
    "extensionToLanguage": { ".py": "python", ".pyi": "python" }
  },
  "typescript-language-server-via-lsp-det": {
    "command": "lsp-det",
    "args": ["--", "typescript-language-server", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  }
}
